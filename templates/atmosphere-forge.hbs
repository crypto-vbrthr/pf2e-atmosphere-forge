<section class="atmosphere-forge-window">
  <header class="atmosphere-forge-header">
    <h2>{{localize "PF2EATMOSPHEREFORGE.Title"}}</h2>
    <p>{{localize "PF2EATMOSPHEREFORGE.Subtitle"}}</p>
  </header>

  <div class="atmosphere-forge-grid">
    <aside class="atmosphere-forge-panel">
      <h3>{{localize "PF2EATMOSPHEREFORGE.Settings.Title"}}</h3>

      <div class="form-group">
        <label>{{localize "PF2EATMOSPHEREFORGE.Settings.Environment"}}</label>
        <select name="environment">
          {{#each environments}}
            <option value="{{this.id}}" {{#if (eq this.id ../selectedEnvironment)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>

      <div class="form-group">
        <label>{{localize "PF2EATMOSPHEREFORGE.Settings.Intensity"}}</label>
        <input type="range" name="intensity" min="0" max="100" value="{{selectedIntensity}}" />
      </div>

      <hr />

      <h3>{{localize "PF2EATMOSPHEREFORGE.SceneParameters.Title"}}</h3>

      <div class="form-group atmosphere-forge-checkbox-row">
        <label>
          <input type="checkbox" name="useWeather" {{#if useWeather}}checked{{/if}} />
          {{localize "PF2EATMOSPHEREFORGE.SceneParameters.UseWeather"}}
        </label>
      </div>

      <div class="form-group">
        <label>{{localize "PF2EATMOSPHEREFORGE.SceneParameters.Weather"}}</label>
        <select name="weather" {{#unless useWeather}}disabled{{/unless}}>
          {{#each weatherOptions}}
            <option value="{{this.id}}" {{#if (eq this.id ../selectedWeather)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{#unless useWeather}}
          <p class="atmosphere-forge-help">{{localize "PF2EATMOSPHEREFORGE.SceneParameters.WeatherDisabledHint"}}</p>
        {{/unless}}
      </div>

      <div class="form-group atmosphere-forge-checkbox-row">
        <label>
          <input type="checkbox" name="useTimeOfDay" {{#if useTimeOfDay}}checked{{/if}} />
          {{localize "PF2EATMOSPHEREFORGE.SceneParameters.UseTimeOfDay"}}
        </label>
      </div>

      <div class="form-group">
        <label>{{localize "PF2EATMOSPHEREFORGE.SceneParameters.TimeOfDay"}}</label>
        <select name="timeOfDay" {{#unless useTimeOfDay}}disabled{{/unless}}>
          {{#each timeOfDayOptions}}
            <option value="{{this.id}}" {{#if (eq this.id ../selectedTimeOfDay)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{#unless useTimeOfDay}}
          <p class="atmosphere-forge-help">{{localize "PF2EATMOSPHEREFORGE.SceneParameters.TimeOfDayDisabledHint"}}</p>
        {{/unless}}
      </div>

      <div class="atmosphere-forge-status">
        {{#if weatherForgeActive}}
          <i class="fa-solid fa-cloud-sun"></i>
          {{localize "PF2EATMOSPHEREFORGE.WeatherForge.Active"}}

          <div class="atmosphere-forge-weather-context">
            <div>{{weatherContext.label}}</div>
            <div>{{localize "PF2EATMOSPHEREFORGE.SceneParameters.Weather"}}: {{weatherContext.weatherLabel}}</div>
            <div>{{localize "PF2EATMOSPHEREFORGE.SceneParameters.TimeOfDay"}}: {{weatherContext.timeOfDayLabel}}</div>
          </div>

          <button type="button" data-action="reloadWeather" class="atmosphere-forge-secondary-button">
            <i class="fa-solid fa-rotate"></i>
            {{localize "PF2EATMOSPHEREFORGE.Actions.ReloadWeather"}}
          </button>
        {{else}}
          <i class="fa-solid fa-cloud"></i>
          {{localize "PF2EATMOSPHEREFORGE.WeatherForge.Inactive"}}
        {{/if}}
      </div>
    </aside>

    <main class="atmosphere-forge-panel atmosphere-forge-preview-panel">
      <h3>{{localize "PF2EATMOSPHEREFORGE.Preview.Title"}}</h3>

      {{#if result}}
        <div class="atmosphere-forge-meta">
          <span>{{result.environmentLabel}}</span>
          <span>{{result.intensityLabel}}</span>
          {{#if result.sceneParameters.useWeather}}
            <span>{{localize "PF2EATMOSPHEREFORGE.SceneParameters.Weather"}}: {{result.sceneParameters.weatherLabel}}</span>
          {{/if}}
          {{#if result.sceneParameters.useTimeOfDay}}
            <span>{{localize "PF2EATMOSPHEREFORGE.SceneParameters.TimeOfDay"}}: {{result.sceneParameters.timeOfDayLabel}}</span>
          {{/if}}
        </div>

        <div class="atmosphere-forge-section-list">
          {{#each result.sections}}
            <section class="atmosphere-forge-section atmosphere-forge-section-{{this.id}}">
              <h4>
                <i class="{{this.icon}}"></i>
                {{this.label}}
              </h4>
              <p>{{this.text}}</p>
            </section>
          {{/each}}
        </div>
      {{else}}
        <div class="atmosphere-forge-preview atmosphere-forge-empty" data-preview>{{previewText}}</div>
      {{/if}}
    </main>

    <aside class="atmosphere-forge-panel">
      <h3>{{localize "PF2EATMOSPHEREFORGE.Actions.Title"}}</h3>

      <button type="button" data-action="generate">
        <i class="fa-solid fa-dice-d20"></i>
        {{localize "PF2EATMOSPHEREFORGE.Actions.Generate"}}
      </button>

      <button type="button" data-action="sendGM" {{#unless canSend}}disabled{{/unless}}>
        <i class="fa-solid fa-user-secret"></i>
        {{localize "PF2EATMOSPHEREFORGE.Actions.SendGM"}}
      </button>

      <button type="button" data-action="sendPublic" {{#unless canSend}}disabled{{/unless}}>
        <i class="fa-solid fa-comments"></i>
        {{localize "PF2EATMOSPHEREFORGE.Actions.SendPublic"}}
      </button>
    </aside>
  </div>
</section>
